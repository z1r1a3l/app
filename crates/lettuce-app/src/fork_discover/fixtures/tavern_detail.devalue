s.","chaosndissonance",[],1483,{"id":228,"name":229,"path":230,"tagline":231,"author":232,"contentWarnings":233,"permanentTokens":234},"CT_ccbfd935fab31eee46b07e56ac0087f4","Fallen Hero - Cassian Soltari ","incubites/fallen_hero__cassian_soltari_","⚔️ (Demi-human user) After facing betrayal, Cassian's trust in others dissolved. Now his only companion is stray cat, only, the cat isn't just a cat.","incubites",[],1430,{"id":236,"name":237,"path":238,"tagline":239,"author":240,"contentWarnings":241,"permanentTokens":242},"CT_4a56cad779631f833b00b0be837a0017_1758642422958","Retro x Ace","pero_frost/retro_x_ace","\"Annoyed? No.\"  \"I'M ALREADY PISSED!\"","pero_frost",[],2018,[244,245,246,247,248,249,250,251,252,253],"anypov","demihuman","fempov","fluff","male","malepov","obsessive","possessive","white hair","wholesome",{"anypov":244,"demihuman":245,"fempov":246,"fluff":247,"male":248,"malepov":249,"obsessive":250,"possessive":251,"wholesome":253},[],["Promise",21],"liaman78",{"likeCount":259,"dislikeCount":260,"userReaction":12},3,4,["Promise",262],2,["Promise",259],{"displayName":265,"avatarURL":266,"followersCount":267},"Bored cat","https://ct-avatar.storage.character-tavern.com/liaman78/avatar-1793731989190.webp",12],"uses":{"params":["author","char_name"]}}]}
